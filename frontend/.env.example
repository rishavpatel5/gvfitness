# GV FITNESS FRONTEND ENVIRONMENT VARIABLES (Example / Production Template)
# In Vite, variables exposed to the client must start with VITE_

# Production Backend API Endpoint (e.g. Railway or Custom Domain)
VITE_API_URL=https://api.gvfitness.in/api

# Production Public URL for Member Invoices & Receipts
VITE_PUBLIC_INVOICE_BASE_URL=https://gvfitness.in

# Production Public URL for Diet Plan PDF Views
VITE_PUBLIC_DIET_PLAN_BASE_URL=https://gvfitness.in

