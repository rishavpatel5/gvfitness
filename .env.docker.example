# ==========================================
# GV FITNESS DOCKER & DEPLOYMENT CONFIGURATION
# ==========================================

# 1. POSTGRES DATABASE
POSTGRES_USER=gvfitness
POSTGRES_PASSWORD=gvfitness2026_db_pass
POSTGRES_DB=gvfitness_db

# 2. BACKEND API & BIOMETRIC GATEWAY
PORT=5000
DEVICE_GATEWAY_PORT=8081
NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=gvfitness2026

# WATI WhatsApp API Token
WATI_API_ENDPOINT=https://live-mt-server.wati.io
WATI_ACCESS_TOKEN=

# eSSL K90 Pro Device Gateway
DEVICE_WHITELIST_SERIALS=*
DEVICE_DEBOUNCE_MINUTES=3
DEVICE_PUSH_DELAY_SECONDS=10
DEVICE_TIMEZONE=5.5

# 3. FRONTEND PUBLIC URLS (Baked into build or runtime)
# Locally: http://localhost:5000/api and http://localhost:5373
# Production (e.g. Railway): https://your-backend.railway.app/api and https://your-frontend.railway.app
VITE_API_URL=http://localhost:5000/api
VITE_PUBLIC_INVOICE_BASE_URL=http://localhost:5373
VITE_PUBLIC_DIET_PLAN_BASE_URL=http://localhost:5373
PUBLIC_INVOICE_BASE_URL=http://localhost:5373
PUBLIC_DIET_PLAN_BASE_URL=http://localhost:5373
WATI_DIET_PLAN_TEMPLATE=gvfitness_diet_plan_v1

