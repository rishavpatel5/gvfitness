PORT=5000
DEVICE_GATEWAY_PORT=8081
NODE_ENV=development

# SUPABASE CREDENTIALS (Add your Supabase project URL and keys here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WATI WHATSAPP CREDENTIALS (Add your WATI API endpoint and token here)
WATI_API_ENDPOINT=https://live-server-XXXX.wati.io
WATI_ACCESS_TOKEN=your-wati-token

# WATI WHATSAPP TEMPLATES (Customizable for GV Fitness)
# 1. Birthday Greetings (Automated daily 10:00 AM IST)
WATI_BIRTHDAY_TEMPLATE=gv_birthday_wish

# 2. Advance Expiry Reminders (7 days, 3 days, 1 day before expiry)
WATI_EXPIRY_REMINDER_TEMPLATE=gv_expiry_reminder

# 3. One-Time Notification on the Exact Expired Day
WATI_EXPIRED_DAY_TEMPLATE=gv_membership_expired

# 4. Official Tax Invoice & Payment Receipt
WATI_INVOICE_TEMPLATE=gv_invoice_receipt

# 5. Welcome Greeting for New Member Registration
WATI_WELCOME_MEMBER_TEMPLATE=gv_welcome_member

# 6. Bulk Promotional WhatsApp Campaigns & Offers
WATI_CAMPAIGN_TEMPLATE=gv_promotional_offer

# 7. Membership Renewal Confirmation (Triggered automatically whenever any member is renewed)
WATI_RENEWAL_CONFIRMATION_TEMPLATE=gv_renewal_confirmation

# 8. Personalized Member Diet Plan (Sent on-demand with 14-day secure link)
WATI_DIET_PLAN_TEMPLATE=gvfitness_diet_plan_v1

# =======================================================
# PUBLIC APPLICATION & INVOICE URLS
# =======================================================
# Base URL sent in WhatsApp invoice links (e.g. http://localhost:5373 locally, or https://gvfitness.in on Railway/Vercel)
PUBLIC_INVOICE_BASE_URL=https://gvfitness.in

# Base URL sent in WhatsApp Diet Plan links (e.g. http://localhost:5373 locally, or https://gvfitness.in on Railway/Vercel)
PUBLIC_DIET_PLAN_BASE_URL=https://gvfitness.in

# =======================================================
# FINGERPRINT DEVICE GATEWAY (eSSL K90 Pro / ADMS Push)
# =======================================================
DEVICE_GATEWAY_PORT=8081
DEVICE_WHITELIST_SERIALS=*
DEVICE_DEBOUNCE_MINUTES=3
DEVICE_PUSH_DELAY_SECONDS=10
DEVICE_TIMEZONE=5.5
